# Copy to .env and run: node --env-file=.env server.mjs

# AI chat (Claude). Without it, the chat runs a deterministic command parser.
ANTHROPIC_API_KEY=
# Only for API keys that are not scoped to a workspace (Console → Settings → Workspaces → the workspace ID).
# ANTHROPIC_WORKSPACE_ID=
# GLIDY_MODEL=
# GLIDY_EFFORT=medium

# Signs sessions and tickets. Required on Vercel (all instances must share it): openssl rand -hex 32
GLIDY_SECRET=

# Solana RPC. Public endpoints rate-limit and refuse some reads (token accounts, positions), so set your own
# (Helius, Triton, QuickNode…) in production. The public endpoints stay as a fallback.
SOLANA_RPC=
# Jupiter (swaps, prices, token info). A key from portal.jup.ag raises the rate limit.
# JUP_API=https://lite-api.jup.ag
JUP_API_KEY=

# Server
# PORT=9330
# HOST=127.0.0.1
# TRUST_PROXY=1        # behind a reverse proxy: read the client IP from X-Forwarded-For
# COOKIE_SECURE=1      # serving over HTTPS
# GLIDY_DATA=./data    # where policy, limits, journal and API token hashes live

# Offline demo: simulated quotes and chain reads. Never use for real trades.
# GLIDY_MOCK=1

# Hyperliquid market data (read-only)
# HL_INFO_URL=https://api.hyperliquid.xyz/info
